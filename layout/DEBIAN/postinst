#!/bin/sh
set -e

if [ -f /usr/bin/proxyswitcherctl ]; then
	chown root:wheel /usr/bin/proxyswitcherctl 2>/dev/null || chown root:root /usr/bin/proxyswitcherctl
	chmod 4755 /usr/bin/proxyswitcherctl
fi

if [ -f /var/jb/usr/bin/proxyswitcherctl ]; then
	chown root:wheel /var/jb/usr/bin/proxyswitcherctl 2>/dev/null || chown root:root /var/jb/usr/bin/proxyswitcherctl
	chmod 4755 /var/jb/usr/bin/proxyswitcherctl
fi

if [ -f /Library/LaunchDaemons/com.example.proxyswitcher.helper.plist ]; then
	launchctl unload /Library/LaunchDaemons/com.example.proxyswitcher.helper.plist >/dev/null 2>&1 || true
	rm -f /Library/LaunchDaemons/com.example.proxyswitcher.helper.plist
fi
launchctl remove com.example.proxyswitcher.helper >/dev/null 2>&1 || true

if [ -f /Library/LaunchDaemons/codes.var.tweak.proxyswitcher.helper.plist ]; then
	chown root:wheel /Library/LaunchDaemons/codes.var.tweak.proxyswitcher.helper.plist 2>/dev/null || chown root:root /Library/LaunchDaemons/codes.var.tweak.proxyswitcher.helper.plist
	chmod 0644 /Library/LaunchDaemons/codes.var.tweak.proxyswitcher.helper.plist
	launchctl unload /Library/LaunchDaemons/codes.var.tweak.proxyswitcher.helper.plist >/dev/null 2>&1 || true
	launchctl load /Library/LaunchDaemons/codes.var.tweak.proxyswitcher.helper.plist >/dev/null 2>&1 || true
fi

if command -v uicache >/dev/null 2>&1 && [ -d /Applications/ProxySwitcher.app ]; then
	uicache -p /Applications/ProxySwitcher.app || true
fi

exit 0
